{
  "name": "onejs-svelte",
  "version": "0.1.0",
  "description": "Svelte 5 for OneJS: Svelte components rendered to Unity's UI Toolkit",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./renderer": "./src/renderer.ts",
    "./esbuild": "./src/esbuild.mjs",
    "./elements": {
      "types": "./src/elements.d.ts"
    }
  },
  "bin": {
    "onejs-svelte": "src/cli.mjs"
  },
  "files": [
    "src"
  ],
  "keywords": [
    "svelte",
    "unity",
    "ui-toolkit",
    "onejs",
    "game-ui",
    "renderer"
  ],
  "author": "Singtaa",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "onejs-elements": "^0.1.0"
  },
  "peerDependencies": {
    "svelte": "5.59.2",
    "unity-types": "^6000.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.0.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "onejs-elements": "file:../onejs-elements",
    "svelte": "5.59.2",
    "svelte-check": "^4.7.8",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0",
    "unity-types": "file:../unity-types",
    "vitest": "^2.1.0"
  }
}
